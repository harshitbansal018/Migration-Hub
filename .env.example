# ===============================
# SERVER
# ===============================
PORT=3005

# Public HTTPS URL of this app, no trailing slash.
# Must match the App URL in the Partner Dashboard exactly, and the redirect
# URL there must be exactly HOST + /api/auth/callback.
HOST=https://lj95svpc-3005.inc1.devtunnels.ms

# ===============================
# SHOPIFY
# ===============================
# Partner Dashboard > your app > Configuration > Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Admin API version used for GraphQL calls and webhook registration.
SHOPIFY_API_VERSION=2025-07

# Access scopes requested during OAuth. Changing this requires merchants to
# reinstall. What the migration needs, per data type:
#   products, collections   write_products (+ write_inventory, read_locations for stock)
#   customers               write_customers  -- protected customer data: request
#                           access in Partner Dashboard > API access first
#   orders                  write_orders
#   coupons                 write_discounts
#   pages, blog posts       write_content
#   301 redirects           write_online_store_navigation
#   publish to Online Store write_publications
SHOPIFY_SCOPES=write_products,write_customers,write_orders,write_discounts,write_content,write_online_store_navigation,write_publications,read_locations,write_inventory

# Timeout for outbound Shopify calls, in milliseconds.
SHOPIFY_TIMEOUT_MS=15000

# ===============================
# ENCRYPTION
# ===============================
# 32 bytes, base64 or hex. Encrypts stores.access_token / refresh_token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored token undecryptable -- all stores must reinstall.
TOKEN_ENCRYPTION_KEY=cic+R3OsnSK5wdafMnILSljoeid40ArvkOjwxscc6yw=

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=migration_tool
DB_POOL_SIZE=10

# ===============================
# MIGRATION
# ===============================
# Run the migration worker inside the web process. Defaults to true unless
# NODE_ENV=production; in production run "npm run worker" separately.
RUN_WORKER_IN_WEB=true

# Where migration files live. Must be PRIVATE (never under public/) and
# excluded from git. Defaults to ./storage
# STORAGE_DIR=

# Encrypts migration files. 32 bytes, hex or base64. When empty, a key is
# derived from TOKEN_ENCRYPTION_KEY. Changing it makes existing files unreadable.
# FILE_ENCRYPTION_KEY=

# How long migration files are kept after a migration finishes.
RETENTION_DAYS_PERSONAL=30
RETENTION_DAYS_OTHER=90

# Load knobs (defaults shown).
MIGRATION_MAX_CONCURRENT=2
MIGRATION_PAGE_SIZE=50
MIGRATION_DEMO_LIMIT=20
MIGRATION_BULK_THRESHOLD=250
MIGRATION_MIN_FREE_DISK_MB=500
SOURCE_PAUSE_MS=250
BULK_POLL_MS=30000

# Allow old-store addresses on private networks (local testing only).
# ALLOW_PRIVATE_SOURCES=false

# ===============================
# EMAIL (optional) -- "migration finished" emails
# ===============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Store Migration <no-reply@example.com>
SUPPORT_EMAIL=
